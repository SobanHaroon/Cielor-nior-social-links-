rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidBrandProfile(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.tagline is string && data.tagline.size() <= 300
        && data.monogram is string && data.monogram.size() <= 10
        && (!('location' in data) || (data.location is string && data.location.size() <= 150))
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 500000))
        && data.links is list && data.links.size() <= 20;
    }

    match /brand_profiles/{profileId} {
      allow get: if isValidId(profileId);
      allow list: if false;
      allow create, update: if isValidId(profileId) && isValidBrandProfile(incoming());
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
